# ─────────────────────────────────────────────
# CodeDost .gitignore
# ─────────────────────────────────────────────

# !! NEVER commit API keys !!
# CodeDost stores keys in localStorage (browser only).
# If you ever move to a .env setup, block it here:
.env
.env.local
.env.production
*.env
config.js
secrets.js
api_keys.txt

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Editor folders
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node (if you ever add a build step)
node_modules/
dist/
build/
.npm

# Python (if you add a backend later)
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
env/
.env/

# Test output
coverage/
.nyc_output/

# Temporary files
*.tmp
*.bak
*.swp
*~
